{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostic-hlds-serverinfo-fixture-contract.schema.json",
  "title": "Diagnostic HLDS Serverinfo Fixture Contract",
  "type": "object",
  "required": [
    "fixture_id",
    "family",
    "stage",
    "evidence_source",
    "evidence_confidence",
    "compatibility_claim",
    "marker_or_header",
    "opcode_or_tag",
    "field_order",
    "fields",
    "string_encoding_policy",
    "numeric_encoding_policy",
    "length_policy",
    "safety_policy",
    "evidence_gap_guard",
    "expected_parse_result",
    "expected_reject_reason",
    "unresolved_fields",
    "safe_preview",
    "notes"
  ],
  "properties": {
    "fixture_id": { "type": "string", "minLength": 1 },
    "family": {
      "type": "string",
      "enum": [
        "connectionless_query_info_candidate",
        "diagnostic_post_connect_serverinfo_current",
        "post_connect_real_serverinfo_unresolved",
        "signon_time_serverinfo_unresolved",
        "invalid_mutation",
        "unknown_unresolved"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "connectionless_query",
        "post_connect",
        "signon_time",
        "diagnostic_current",
        "unresolved"
      ]
    },
    "evidence_source": { "type": "string", "minLength": 1 },
    "evidence_confidence": {
      "type": "string",
      "enum": [
        "local_code",
        "local_artifact",
        "local_doc",
        "synthetic_placeholder",
        "unresolved"
      ]
    },
    "compatibility_claim": {
      "type": "string",
      "enum": [
        "diagnostic_only",
        "fixture_only",
        "unresolved",
        "not_real_client_compatible"
      ]
    },
    "marker_or_header": { "type": "object" },
    "opcode_or_tag": { "type": "object" },
    "field_order": { "type": "array", "items": { "type": "string" } },
    "fields": { "type": "object" },
    "string_encoding_policy": { "type": "object" },
    "numeric_encoding_policy": { "type": "object" },
    "length_policy": { "type": "object" },
    "safety_policy": {
      "type": "object",
      "required": [
        "real_steam_client_used",
        "real_client_binary_invoked",
        "public_socket_opened",
        "normal_host_behavior_changed",
        "real_client_smoke_allowed_now"
      ],
      "properties": {
        "real_steam_client_used": { "type": "boolean", "const": false },
        "real_client_binary_invoked": { "type": "boolean", "const": false },
        "public_socket_opened": { "type": "boolean", "const": false },
        "normal_host_behavior_changed": { "type": "boolean", "const": false },
        "real_client_smoke_allowed_now": { "type": "boolean", "const": false }
      }
    },
    "evidence_gap_guard": {
      "type": "object",
      "required": [
        "evidence_gap_guard_enabled",
        "stage_confusion_guard_enabled",
        "diagnostic_preview_not_byte_evidence",
        "connectionless_query_not_post_connect",
        "connectionless_query_not_signon",
        "unresolved_real_stage_not_buildable",
        "byte_level_evidence_required_for_real_stage",
        "real_stage_buildable",
        "real_stage_parseable",
        "byte_level_evidence_status",
        "forbidden_promotions",
        "required_before_promotion",
        "expected_guard_reject_reason"
      ],
      "properties": {
        "evidence_gap_guard_enabled": { "type": "boolean", "const": true },
        "stage_confusion_guard_enabled": { "type": "boolean", "const": true },
        "diagnostic_preview_not_byte_evidence": { "type": "boolean", "const": true },
        "connectionless_query_not_post_connect": { "type": "boolean", "const": true },
        "connectionless_query_not_signon": { "type": "boolean", "const": true },
        "unresolved_real_stage_not_buildable": { "type": "boolean", "const": true },
        "byte_level_evidence_required_for_real_stage": { "type": "boolean", "const": true },
        "real_stage_buildable": { "type": "boolean", "const": false },
        "real_stage_parseable": { "type": "boolean", "const": false },
        "byte_level_evidence_status": {
          "type": "string",
          "enum": [
            "connectionless_only",
            "diagnostic_preview_only",
            "insufficient",
            "synthetic_placeholder",
            "unresolved"
          ]
        },
        "forbidden_promotions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "connectionless_query_to_post_connect",
              "connectionless_query_to_signon",
              "diagnostic_preview_to_real_wire",
              "unresolved_to_compatible"
            ]
          }
        },
        "required_before_promotion": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "local_byte_level_fixture",
              "local_field_order_evidence",
              "local_opcode_or_message_id_evidence",
              "local_string_encoding_evidence",
              "local_numeric_encoding_evidence",
              "validator_promotion_gate"
            ]
          }
        },
        "expected_guard_reject_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "expected_parse_result": {
      "type": "string",
      "enum": [
        "valid_fixture_only",
        "invalid_rejected",
        "unresolved_not_parseable"
      ]
    },
    "expected_reject_reason": { "type": "string" },
    "unresolved_fields": { "type": "array", "items": { "type": "string" } },
    "safe_preview": { "type": "object" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
